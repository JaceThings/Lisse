{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // The Paraglide runtime in src/paraglide is JSDoc-typed .js (build output,
    // gitignored, regenerated by the vite plugin / `pnpm run paraglide`).
    // allowJs lets tsc read those JSDoc types for importers; checkJs stays off
    // so the generated code itself isn't type-checked.
    "allowJs": true,
    "useDefineForClassFields": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"]
}
