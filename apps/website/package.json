{
  "name": "website",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "corne.rs landing site for the Lisse squircle library",
  "scripts": {
    "predev": "tsx scripts/build-llms-full.ts && tsx scripts/build-sitemap.ts",
    "dev": "vite dev",
    "prebuild": "tsx scripts/build-llms-full.ts && tsx scripts/write-version.ts && tsx scripts/build-sitemap.ts",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "node .output/server/index.mjs",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "pretypecheck": "pnpm run paraglide",
    "typecheck": "tsc --noEmit",
    "validate:translations": "tsx scripts/validate-translations.ts",
    "build:llms": "tsx scripts/build-llms-full.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@fontsource-variable/noto-sans-kr": "^5.2.10",
    "@highlighters/core": "^1.2.0",
    "@inlang/paraglide-js": "^2.18.1",
    "@lisse/core": "workspace:*",
    "@lisse/react": "workspace:*",
    "@numeric-text/react": "^0.1.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.9",
    "@tanstack/react-start": "^1.168.16",
    "agentation": "^3.0.2",
    "framer-motion": "^12.38.0",
    "justif": "^0.6.4",
    "matter-js": "^0.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "nitro": "3.0.260522-beta",
    "typescript": "^5.7.0",
    "vite": "^7.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
