{
  "name": "lisse",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" build",
    "test": "vitest run",
    "bench": "vitest bench --config benchmarks/vitest.config.ts --run",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "changelog:root": "tsx scripts/update-root-changelog.ts",
    "consumer-smoke": "bash scripts/consumer-smoke.sh",
    "size": "size-limit",
    "knip": "knip --reporter compact",
    "coverage": "vitest run --coverage"
  },
  "size-limit": [
    {
      "name": "@lisse/core (ESM, brotli)",
      "path": "packages/core/dist/index.js",
      "limit": "12 KB"
    },
    {
      "name": "@lisse/core/path (ESM, brotli)",
      "path": "packages/core/dist/path.js",
      "limit": "4.5 KB"
    },
    {
      "name": "@lisse/react (incl. core, ESM, brotli, excluding peer dep)",
      "path": "packages/react/dist/index.js",
      "limit": "12 KB",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "@lisse/vue (incl. core, ESM, brotli, excluding peer dep)",
      "path": "packages/vue/dist/index.js",
      "limit": "12 KB",
      "ignore": [
        "vue"
      ]
    },
    {
      "name": "@lisse/svelte (incl. core, ESM, brotli, excluding peer dep)",
      "path": "packages/svelte/dist/index.js",
      "limit": "10.5 KB",
      "ignore": [
        "svelte"
      ]
    },
    {
      "name": "@lisse/octane (incl. core, ESM, brotli, excluding peer dep)",
      "path": "packages/octane/dist/index.js",
      "limit": "12.5 KB",
      "ignore": [
        "octane"
      ]
    }
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@argos-ci/playwright": "^7.0.3",
    "@changesets/cli": "^2.27.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.6.0",
    "knip": "^6.14.2",
    "playwright": "^1.60.0",
    "publint": "^0.3.21",
    "size-limit": "^12.1.0",
    "svg-path-properties": "^2.0.2",
    "svgpath": "^2.6.0",
    "tsup": "^8.4.0",
    "tsx": "^4.8.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
